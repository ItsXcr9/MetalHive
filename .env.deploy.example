# MetalHive Deploy Environment Variables
# Copy this file to .env and configure for your server

# Server IP/Domain
SERVER_IP=YOUR_SERVER_IP

# UI Credentials
UI_USERNAME=admin
UI_PASSWORD=changeme

# API URLs (update with your server IP)
API_URL=http://${SERVER_IP}:8080
WS_URL=ws://${SERVER_IP}:8080
ANCIENTREPORT_API=http://${SERVER_IP}:6080
ANCIENTREPORT_UI_URL=http://${SERVER_IP}:6080
ANCIENTREPORT_API_URL=http://${SERVER_IP}:6080
MITHRILLOG_API_URL=http://${SERVER_IP}:9900

# AI Provider Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash-lite
